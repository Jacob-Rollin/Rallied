# ── Discord (bot) ──────────────────────────────────────────
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: guild id to register slash commands instantly while developing
DISCORD_DEV_GUILD_ID=

# ── Discord OAuth (admin web — identify + guilds only) ─────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# iron-session cookie encryption (≥32 characters)
SESSION_SECRET=replace-with-a-long-random-string-32chars-min
# Force mock admin session (default when OAuth secrets missing)
# MOCK_AUTH=1

# ── Supabase (bot + web dashboard need service role) ───────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web Worker also needs SUPABASE_SERVICE_ROLE_KEY (server-only) for /app live reads —
# RLS has no anon policies. Never expose as NEXT_PUBLIC_*.

# ── Web (Next.js) — copy into apps/web/.env.local ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional on web Worker: DISCORD_BOT_TOKEN for bot_present via Discord API


# ── Billing placeholder (wire Stripe later — no charges in scaffold) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
