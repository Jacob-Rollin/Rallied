# ── Discord (bot) ──────────────────────────────────────────
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: guild id to register slash commands instantly while developing
DISCORD_DEV_GUILD_ID=

# ── Discord OAuth (admin web — identify + guilds only) ─────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# iron-session cookie encryption (≥32 characters)
SESSION_SECRET=replace-with-a-long-random-string-32chars-min
# Force mock admin session (default when OAuth secrets missing)
# MOCK_AUTH=1

# ── Supabase (bot + web dashboard need service role) ───────
# Project URL only: https://xxx.supabase.co — not the /rest/v1 REST path
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web Worker also needs SUPABASE_SERVICE_ROLE_KEY (server-only) for /app live reads —
# RLS has no anon policies. Never expose as NEXT_PUBLIC_*.

# ── Web (Next.js) — copy into apps/web/.env.local ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional on web Worker: DISCORD_BOT_TOKEN for bot_present via Discord API


# ── Bot public links + dogfood allowlist ───────────────────
# PUBLIC_WEB_URL=https://rallied.gg
# Comma-separated guild ids treated as founding_pro (skip Starter caps)
# DOGFOOD_GUILD_IDS=1564716956198899824

# ── Stripe (web Worker secrets — test mode first) ─────────
# Never put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET in NEXT_PUBLIC_*.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…   # from Stripe Dashboard → Webhooks → endpoint
# Optional publishable (Checkout is hosted; not required for Path B v1):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
# Price IDs (Dashboard → Products). Monthly aliases without _MONTHLY still work:
# STRIPE_PRICE_COMMUNITY_MONTHLY=price_…   # $4.99/mo  (or STRIPE_PRICE_COMMUNITY)
# STRIPE_PRICE_COMMUNITY_YEARLY=price_…    # $49/yr
# STRIPE_PRICE_PRO_MONTHLY=price_…         # $9.99/mo  (or STRIPE_PRICE_PRO)
# STRIPE_PRICE_PRO_YEARLY=price_…          # $99/yr
# STRIPE_PRICE_FOUNDING_PRO_MONTHLY=price_… # $8.99/mo (or STRIPE_PRICE_FOUNDING_PRO)
# STRIPE_PRICE_FOUNDING_PRO_YEARLY=price_…  # $89/yr — optional; coupon/manual OK
# Webhook URL: https://YOUR_DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# Official Rallied forever Pro: see docs/rallied-supabase-012-stripe-billing.sql
