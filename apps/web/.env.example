NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Discord OAuth (server-only — never NEXT_PUBLIC_ the secret)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=replace-with-a-long-random-string-32chars-min

# Optional: bot token so dashboard can verify bot is in each guild
DISCORD_BOT_TOKEN=
# Optional: service role for upserting dashboard_users
SUPABASE_SERVICE_ROLE_KEY=

# MOCK_AUTH=1   # force mock admin even if OAuth is configured
