NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Discord OAuth (server-only — never NEXT_PUBLIC_ the secret)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=replace-with-a-long-random-string-32chars-min

# Required for live /app dashboard reads (RLS blocks anon — server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bot token so dashboard can verify bot is in each guild via Discord API.
# If unset, bot_present uses rows in Supabase `servers` (bot upserts on slash commands).
DISCORD_BOT_TOKEN=

# MOCK_AUTH=1   # force mock admin even if OAuth is configured
# ?mock=1 on /app/* forces mock UI preview while logged into a real guild
